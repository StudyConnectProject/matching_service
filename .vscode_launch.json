{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Server",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}",
            "env": {
                "APP_PORT": "8084",
                "DB_HOST": "localhost",
                "DB_PORT": "5432",
                "DB_USER": "postgres",
                "DB_PASSWORD": "postgres",
                "DB_NAME": "matching_db",
                "JWT_SECRET": "debug-secret-key",
                "LOG_LEVEL": "debug"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "trace": "verbose",
            "logOutput": "rpc"
        },
        {
            "name": "Test Package",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}",
            "args": [
                "-v",
                "-race",
                "-coverprofile=coverage.out"
            ]
        },
        {
            "name": "Attach to Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": "dlv-adapter",
            "substitutePath": [
                {
                    "from": "${workspaceFolder}",
                    "to": "/app"
                }
            ]
        }
    ]
}
